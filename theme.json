{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "name": "Kem nền", "slug": "background", "color": "#FAF6EE" },
        { "name": "Kem đậm", "slug": "background-alt", "color": "#F1E9D8" },
        { "name": "Chữ chính", "slug": "ink", "color": "#1C2B27" },
        { "name": "Chữ phụ", "slug": "ink-soft", "color": "#52655F" },
        { "name": "Xanh chủ đạo", "slug": "primary", "color": "#0E5C52" },
        { "name": "Xanh đậm", "slug": "primary-dark", "color": "#0A403A" },
        { "name": "Xanh sage", "slug": "sage", "color": "#8FB79A" },
        { "name": "Xanh nhạt", "slug": "sage-pale", "color": "#E1EEE2" },
        { "name": "Vàng nhấn", "slug": "accent", "color": "#D9A441" },
        { "name": "Vàng đậm", "slug": "accent-dark", "color": "#B9832B" },
        { "name": "Trắng", "slug": "white", "color": "#FFFFFF" }
      ],
      "gradients": [
        {
          "name": "Xanh chuyên môn",
          "slug": "clinical",
          "gradient": "linear-gradient(135deg, #0A403A 0%, #0E5C52 100%)"
        },
        {
          "name": "Kem ấm",
          "slug": "warm",
          "gradient": "linear-gradient(135deg, #FAF6EE 0%, #F1E9D8 100%)"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        { "name": "2XS", "slug": "20", "size": "0.5rem" },
        { "name": "XS", "slug": "30", "size": "0.75rem" },
        { "name": "S", "slug": "40", "size": "1rem" },
        { "name": "M", "slug": "50", "size": "clamp(1.25rem, 2vw, 2rem)" },
        { "name": "L", "slug": "60", "size": "clamp(2rem, 4vw, 4rem)" },
        { "name": "XL", "slug": "70", "size": "clamp(3.5rem, 7vw, 7.5rem)" }
      ]
    },
    "typography": {
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Arial, sans-serif",
          "name": "Sans hiện đại",
          "slug": "body"
        },
        {
          "fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif",
          "name": "Serif thanh lịch",
          "slug": "display"
        },
        {
          "fontFamily": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
          "name": "Mono nhãn",
          "slug": "mono"
        }
      ],
      "fontSizes": [
        { "name": "Nhỏ", "slug": "small", "size": "0.875rem" },
        { "name": "Văn bản", "slug": "medium", "size": "1rem" },
        { "name": "Lớn", "slug": "large", "size": "1.15rem" },
        { "name": "Tiêu đề nhỏ", "slug": "x-large", "size": "clamp(1.9rem, 3.5vw, 3.2rem)" },
        { "name": "Tiêu đề lớn", "slug": "xx-large", "size": "clamp(2.5rem, 5vw, 4.1rem)" }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "name": "Thẻ",
          "slug": "card",
          "shadow": "0 20px 50px -25px rgba(10,64,58,0.35)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "var:preset|spacing|40",
        "right": "var:preset|spacing|40"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.6"
    },
    "elements": {
      "button": {
        "border": { "radius": "999px" },
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|primary-dark"
        },
        "spacing": {
          "padding": {
            "top": "0.78rem",
            "right": "1.4rem",
            "bottom": "0.78rem",
            "left": "1.4rem"
          }
        },
        "typography": { "fontFamily": "var:preset|font-family|body", "fontSize": "0.92rem", "fontWeight": "700" }
      },
      "heading": {
        "color": { "text": "var:preset|color|primary-dark" },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "600", "lineHeight": "1.12" }
      },
      "link": {
        "color": { "text": "var:preset|color|primary" }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": { "fontFamily": "var:preset|font-family|body", "fontSize": "0.92rem", "fontWeight": "600" }
      },
      "core/post-title": {
        "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "600", "lineHeight": "1.12" }
      },
      "core/post-excerpt": {
        "color": { "text": "var:preset|color|ink-soft" }
      },
      "core/query-pagination": {
        "typography": { "fontWeight": "700" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Đầu trang", "area": "header" },
    { "name": "footer", "title": "Chân trang", "area": "footer" }
  ]
}
